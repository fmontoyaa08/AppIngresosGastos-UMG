<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Lado Izquierdo: Descripción, Categoría y Fecha -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescripcionItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wendys"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1F2937" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvCategoriaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alimentación"
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/tvFechaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-10-17"
                android:textSize="13sp"
                android:textColor="#6B7280" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lado Derecho: Monto -->
    <TextView
        android:id="@+id/tvMontoItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="Q 200.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1F2937" />

</LinearLayout>